# Python
__pycache__/
*.py[cod]

# Virtual environment
.venv/

# Jupyter
.ipynb_checkpoints/

# Data — raw and large processed files excluded; demo artifacts committed separately
data/raw/*
data/processed/*

# Reports — SHAP and other generated images/CSVs tracked (small)
!reports/churn/
!reports/churn/**

# Models — track lightweight JSON/ONNX, ignore large binary blobs
models/*.pkl
models/*.joblib
models/*.pt
models/*.pth
# churn_xgb.json (~415 KB) is intentionally tracked — do NOT add *.json here

# Environment variables
.env
.env.*

# MLflow
mlruns/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/